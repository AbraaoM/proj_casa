# Neon pooled connection string. Ask Neon or copy it from the project dashboard.
# Do not commit a real value.
DATABASE_URL=

# Optional fallback key for the agent. The panel generates keys on /agentes.
# Send either secret as: Authorization: Bearer <key>
AGENT_API_KEY=

# Local development only: set to "pg" to use node-postgres against a local
# Postgres (e.g. postgresql://casa:casa@localhost:5432/casa_dev). Leave empty on Vercel/Neon.
DATABASE_DRIVER=

# Master key for secrets saved in the app (Telegram token, AI key, Google Agenda refresh token), AES-256-GCM.
# 32 random bytes in base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes the saved secrets unreadable: paste them again.
CASA_SECRET_KEY=

# Optional. Vercel Cron sends it as "Authorization: Bearer <value>" to /api/telegram/digest.
CRON_SECRET=

# Google Agenda OAuth client (Google Cloud → Credentials → OAuth client ID → Web).
# Authorized redirect URI: https://<your-app>/api/google/callback
# Enable the Google Calendar API. See docs/agente-agenda.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
